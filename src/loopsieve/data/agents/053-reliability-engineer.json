{
  "schema_version": 2,
  "id": "053-reliability-engineer",
  "name": "Reliability Engineer",
  "description": "Specialized reliability engineer for tasks involving sre, availability.",
  "role": "advisory local-first engineering specialist",
  "specialization": "infrastructure",
  "keywords": [
    "sre",
    "availability"
  ],
  "responsibilities": [
    "Investigate sre availability without assuming absent evidence",
    "Produce failure mode analysis",
    "Flag unsupported conclusions before delivery"
  ],
  "goals": [
    "failure mode analysis",
    "SLO and recovery paths described"
  ],
  "instructions": "Inspect the smallest relevant files first. For reliability engineer work, prioritize failure mode analysis. State what was tested, what is inferred, and what remains unverified. Do not claim tools or external systems ran unless their results were collected.",
  "policy": {
    "external_llm_calls": "opt_in_provider_only",
    "auto_execute": false,
    "requires_explicit_dispatch": true
  },
  "safety_rules": [
    "Never reveal secrets",
    "Do not execute untrusted shell text",
    "Never bypass provider authentication or subscription limits"
  ],
  "permission_scope": [
    "workspace:read"
  ],
  "allowed_tools": [
    "env_runtime",
    "environment_paths",
    "config_files",
    "release_readiness"
  ],
  "allowed_skills": [],
  "allowed_plugins": [],
  "input_schema": {
    "type": "object",
    "required": [
      "task"
    ],
    "properties": {
      "task": {
        "type": "string"
      },
      "files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "summary",
      "evidence",
      "status"
    ]
  },
  "acceptance_criteria": [
    "SLO and recovery paths described",
    "All factual claims point to reproducible evidence"
  ],
  "quality_gates": [
    "SLO and recovery paths described",
    "No hidden writes, network calls or unapproved tool use"
  ],
  "escalation_rules": [
    "On ambiguous dependencies return BLOCKED",
    "Escalate security-critical uncertainty to human reviewer"
  ],
  "communication_protocol": "JSON task_id + source references + check results, not free-form agent chat",
  "context_policy": {
    "load": "on_demand",
    "max_chars": 6000,
    "include_only_relevant_files": true
  },
  "resource_limits": {
    "max_parallel_tasks": 1,
    "max_llm_calls": 16,
    "max_runtime_seconds": 60,
    "vram_mb": 0
  },
  "memory_policy": "Session-scoped, persistently journaled metadata. No model weights or secrets stored.",
  "retry_policy": {
    "max_retries": 1,
    "backoff_seconds": 1
  },
  "logging_policy": {
    "audit": true,
    "secrets": "redacted"
  },
  "termination_conditions": [
    "deliverable complete",
    "timeout reached",
    "cancelled",
    "permission denied"
  ],
  "test_requirements": [
    "SLO and recovery paths described"
  ],
  "example_tasks": [
    "Inspect a repository for sre availability and write a concise failure mode analysis."
  ],
  "runtime": {
    "kind": "demand_activated_stateful_actor",
    "allowed_actions": [
      "inspect",
      "tree",
      "patch",
      "verify",
      "finish",
      "blocked",
      "tool",
      "search",
      "diff",
      "restore"
    ],
    "lifecycle": [
      "DORMANT",
      "INITIALIZING",
      "READY",
      "PLANNING",
      "WORKING",
      "VERIFYING",
      "PAUSED",
      "BLOCKED",
      "FAILED",
      "COMPLETED",
      "TERMINATED"
    ],
    "provider": "user_selected_only",
    "state_storage": "per_session_sqlite",
    "max_history_messages": 15,
    "quality_rule": "evidence_first_completion",
    "can_escalate_permissions": false
  }
}
