{
  "schema_version": 1,
  "id": "plugin-npx",
  "name": "Node command launcher",
  "kind": "external-cli-adapter",
  "executable": "npx",
  "probe_args": [
    "--version"
  ],
  "operation": "version-health-check",
  "capabilities": [
    "executable-discovery",
    "version-health-check"
  ],
  "permissions": [
    "process:launch:fixed-argv"
  ],
  "installation": "user-managed; no automatic install",
  "status_without_executable": "REQUIRES_DEPENDENCY",
  "version": "1.0",
  "max_probe_seconds": 4
}
