{
  "version": 1,
  "max_context_chars": 9000,
  "max_diagnostic_lines": 36,
  "include_success_context": true,
  "deduplicate_failures": true,
  "checks": [
    {
      "name": "python syntax",
      "command": ["{python}", "-m", "compileall", "-q", "{files}"],
      "kinds": ["python"],
      "timeout_seconds": 45,
      "max_output_chars": 6000,
      "cwd": ".",
      "enabled": true
    },
    {
      "name": "unit tests",
      "command": ["{python}", "-m", "unittest", "discover", "-s", "tests", "-q"],
      "kinds": ["python", "config"],
      "timeout_seconds": 180,
      "max_output_chars": 12000,
      "cwd": ".",
      "enabled": true
    }
  ]
}
